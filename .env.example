# Copy to .env and fill in. Never commit the real .env file.

# development, testing or production
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# PostgreSQL connection URL. Required. The value below is the development-only
# Docker database from compose.yaml; never use these credentials in production.
DATABASE_URL=postgresql://penny:penny@localhost:5432/penny_dev

# Optional. Schema for the connection's search_path. Defaults to public.
# DATABASE_SCHEMA=public

# Optional. 1 serves the maintenance page for every request and skips database start-up.
# MAINTENANCE_MODE=0

# Optional. Database used by the test suite (started by docker compose up -d).
# TEST_DATABASE_URL=postgresql://penny:penny@localhost:5432/penny_test
