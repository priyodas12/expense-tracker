# Copy to .env and fill in. Never commit the real .env file.

# development, testing or production
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional. Defaults to expenses.db in the project root.
# DATABASE=/var/lib/penny-trail/expenses.db
